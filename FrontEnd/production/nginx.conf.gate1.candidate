server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    server_name knowledge.axanh.com;

    # Proposed Docker bridge gateway. Verify during integration.
    allow 172.28.7.1;
    deny all;

    root /usr/share/nginx/html;
    index index.html;
    autoindex off;
    server_tokens off;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;

    location = / {
        try_files /index.html =404;
    }

    location ~ ^/(index\.html|app\.js|api\.js|style\.css|seed-data\.js|IconWeb\.png)$ {
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy same-origin always;

        try_files $uri =404;
    }

    location ^~ /api/ {
        proxy_pass http://172.28.7.20:3100;
        proxy_http_version 1.1;

        proxy_set_header Host knowledge.axanh.com;
        proxy_set_header X-Forwarded-Host knowledge.axanh.com;
        proxy_set_header X-Forwarded-Proto https;

        # Temporary conservative identity: DSM proxy connection.
        # Do not use as final per-user rate-limit identity.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;

        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    location ^~ /auth/ {
        access_log off;

        proxy_pass http://172.28.7.20:3100;
        proxy_http_version 1.1;

        proxy_set_header Host knowledge.axanh.com;
        proxy_set_header X-Forwarded-Host knowledge.axanh.com;
        proxy_set_header X-Forwarded-Proto https;

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;

        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    location / {
        return 404;
    }
}
